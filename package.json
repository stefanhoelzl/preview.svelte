{
  "name": "preview.svelte",
  "version": "0.1.0",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "package": "npm run build && svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "dev": "vite dev",
    "check": "svelte-kit sync && svelte-check --fail-on-warnings --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --fail-on-warnings --tsconfig ./tsconfig.json --watch",
    "lint": "eslint --ext=.svelte,.ts,.js,.json --max-warnings=0",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "svelte": "*"
  },
  "devDependencies": {
    "@eslint/compat": "*",
    "@sveltejs/adapter-auto": "*",
    "@sveltejs/kit": "*",
    "@sveltejs/package": "*",
    "@sveltejs/vite-plugin-svelte": "*",
    "@testing-library/jest-dom": "*",
    "@testing-library/svelte": "*",
    "@types/eslint": "*",
    "@types/node": "*",
    "@typescript-eslint/eslint-plugin": "*",
    "@typescript-eslint/parser": "*",
    "eslint": "*",
    "eslint-config-prettier": "*",
    "eslint-plugin-json": "*",
    "eslint-plugin-prettier": "*",
    "eslint-plugin-svelte": "*",
    "globals": "*",
    "happy-dom": "*",
    "jiti": "*",
    "prettier": "*",
    "prettier-plugin-svelte": "*",
    "publint": "*",
    "svelte": "*",
    "svelte-check": "*",
    "tmp-promise": "*",
    "tslib": "*",
    "typescript": "*",
    "typescript-eslint": "*",
    "vite": "*",
    "vitest": "*"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "dependencies": {}
}
